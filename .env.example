# ── Supabase (your NEW project) ─────────────────────────────────────
# Project: oyhcchumlizmhwvjjlrl
NEXT_PUBLIC_SUPABASE_URL=https://oyhcchumlizmhwvjjlrl.supabase.co
# Service-role key (Settings → API → service_role). SERVER-ONLY — never
# expose to the browser. All screener DB access is server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Market data provider ────────────────────────────────────────────
# 'fmp' for live data, 'mock' for a zero-key demo (deterministic fixtures).
MARKET_DATA_PROVIDER=mock
# Free key from https://financialmodelingprep.com (only needed for 'fmp').
MARKET_DATA_FMP_API_KEY=

# ── Cron (required) ──────────────────────────────────────────────────
# Both /api/ingest and /api/digest check Authorization: Bearer <CRON_SECRET>.
# /api/ingest tolerates this being unset (it spends no money, sends no mail).
# /api/digest does NOT: it fails closed and returns 401 with no CRON_SECRET
# set, so the digest endpoint is disabled until you set a real value here.
CRON_SECRET=

# ── Daily Maily (the 6 AM ET digest) ────────────────────────────────
# Resend API key. UNSET = the send layer no-ops and logs instead, which is
# what keeps local runs and mock deploys from mailing real people.
RESEND_API_KEY=
# Sender identity. Requires the domain verified in Resend (DNS records).
#
# DIGEST_FROM and NEXT_PUBLIC_SITE_URL below should share a domain in
# production: mismatched ones (e.g. mailing from @tripleqgroup.com while the
# footer says "you confirmed your subscription at tripleqgroup.vercel.app")
# read as untrustworthy to a recipient and hurt the domain-alignment signals
# Gmail/other inboxes use for deliverability. If your Resend-verified sending
# domain is tripleqgroup.com, point the app at that domain too (a custom
# domain in Vercel), not at the *.vercel.app default.
DIGEST_FROM=TripleQ Group <daily@tripleqgroup.com>
# Absolute origin for links inside emails. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tripleqgroup.com
# Sole recipient of GET /api/digest?force=1 — for verifying a real send.
DIGEST_TEST_EMAIL=

# ── Email transport ─────────────────────────────────────────────────
# 'smtp' (Gmail — no sending domain required) or 'resend' (needs a VERIFIED
# domain). Omit and it is inferred from whichever credentials are present,
# preferring SMTP.
EMAIL_PROVIDER=smtp
# Gmail SMTP. SMTP_PASSWORD is a Google APP PASSWORD, not your account
# password: myaccount.google.com/apppasswords (requires 2FA enabled).
# DIGEST_FROM's address MUST match SMTP_USER — Gmail rewrites the From header
# to the authenticated account otherwise.
SMTP_USER=
SMTP_PASSWORD=
# Defaults: smtp.gmail.com / 465. Only set these for a non-Gmail server.
SMTP_HOST=
SMTP_PORT=
